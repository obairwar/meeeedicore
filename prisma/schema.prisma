generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECHNICIAN
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum ConsultationType {
  IN_PERSON
  VIDEO
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  DONE
  CANCELLED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum LabStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WardType {
  GENERAL
  ICU
  EMERGENCY
  PRIVATE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  passwordHash String
  role         Role    @default(PATIENT)

  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?
  address     String?

  photoUrl              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  preferredLanguage     String? @default("en")
  notifyWhatsApp        Boolean @default(true)
  notifySms             Boolean @default(true)
  notifyEmail           Boolean @default(true)
  isActive              Boolean @default(true)
  /// Created via reception walk-in quick registration (vs online signup)
  isWalkIn              Boolean @default(false)

  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?

  /// Web Push subscription JSON (endpoint, keys) for queue alerts
  pushSubscriptionJson String?

  familyMembers  FamilyMember[]
  appointments   Appointment[]   @relation("PatientAppointments")
  medicalRecords MedicalRecord[]
  doctorProfile  Doctor?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  beds          Bed[]
  visitors      Visitor[]
  feedbacks     Feedback[] @relation("PatientFeedback")
  auditLogs     AuditLog[]

  maintenanceReports  MaintenanceRequest[] @relation("MaintenanceReporter")
  maintenanceAssigned MaintenanceRequest[] @relation("MaintenanceAssignee")
}

model FamilyMember {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  relation    String
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([userId])
}

model Department {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  floor String
  rooms Int    @default(0)

  doctors      Doctor[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  name            String
  specialization  String
  experienceYears Int
  rating          Float   @default(4.5)
  ratingCount     Int     @default(0)
  consultationFee Int
  bio             String?
  photoUrl        String?

  schedules      DoctorSchedule[]
  appointments   Appointment[]
  queueEntries   QueueEntry[]
  medicalRecords MedicalRecord[]
  feedbacks      Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model DoctorSchedule {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek           DayOfWeek
  workStartTime       String // "09:00"
  workEndTime         String // "17:00"
  slotDurationMinutes Int       @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
}

model Feedback {
  id            String @id @default(cuid())
  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User @relation("PatientFeedback", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  anonymous     Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([doctorId, createdAt])
  @@index([patientId])
}

model Appointment {
  id        String            @id @default(cuid())
  tokenCode String            @unique
  status    AppointmentStatus @default(PENDING)
  priority  Priority          @default(MEDIUM)
  isWalkIn  Boolean           @default(false)

  triageScore          Int?
  triageBpSystolic     Int?
  triageBpDiastolic    Int?
  triagePulse          Int?
  triageTemperature    Float?
  triageSpo2           Int?
  triagePainLevel      Int?
  triageConsciousness  String?
  triageChiefComplaint String?

  patientId      String
  patient        User          @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  startsAt        DateTime
  endsAt          DateTime
  symptoms        String
  notes           String?
  consultationFee Int

  /// Set when the "1 hour before" reminder was sent (WhatsApp + SMS).
  hourReminderSentAt DateTime?

  consultationType ConsultationType @default(IN_PERSON)

  queueEntry    QueueEntry?
  medicalRecord MedicalRecord?
  payments      Payment[]
  feedback      Feedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([departmentId, startsAt])
}

model QueueEntry {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  position              Int
  status                QueueStatus @default(WAITING)
  estimatedWaitMinutes  Int         @default(0)
  currentlyServingToken String?

  calledAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, position])
  @@index([doctorId, status])
}

model MedicalRecord {
  id            String       @id @default(cuid())
  patientId     String
  patient       User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  summary           String
  vitalsBp          String?
  vitalsPulse       Int?
  vitalsTemperature Float?
  vitalsWeight      Float?
  diagnosis         String?
  notes             String?
  followUpAt        DateTime?

  prescriptionPdfUrl String?
  prescriptionQrData String?

  prescriptions Prescription[]
  labOrders     LabOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
}

model Prescription {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  medicineName String
  dosage       String
  frequency    String
  duration     String
  instructions String?
  dispensedAt  DateTime?
  dispensedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicalRecordId])
}

model LabOrder {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  testName  String
  status    LabStatus @default(ORDERED)
  resultUrl String?
  notes     String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicalRecordId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  category     String?
  quantity     Int      @default(0)
  unit         String   @default("unit")
  minThreshold Int      @default(0)
  expiry       DateTime?
  supplier     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([quantity])
}

model Payment {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  amount        Int
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)
  breakdownJson String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?
  invoiceUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType @default(INFO)
  title  String
  body   String?
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
}

model Bed {
  id        String    @id @default(cuid())
  ward      WardType
  bedNumber String
  status    BedStatus @default(AVAILABLE)

  patientId  String?
  patient    User?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  admittedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ward, bedNumber])
  @@index([status])
  @@index([ward])
}

model AuditLog {
  id          String  @id @default(cuid())
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  detailsJson String?
  ipAddress   String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action])
}

model SystemSettings {
  id       String @id @default("default")
  dataJson String @default("{}")

  updatedAt DateTime @updatedAt
}

model MaintenanceRequest {
  id          String             @id @default(cuid())
  reporterId  String
  reporter    User               @relation("MaintenanceReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?              @relation("MaintenanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  location    String
  description String
  priority    Priority           @default(MEDIUM)
  photoUrl    String?
  status      MaintenanceStatus  @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
}

model Visitor {
  id           String @id @default(cuid())
  name         String
  phone        String
  relationship String

  patientId String
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, checkedOutAt])
  @@index([checkedInAt])
}
